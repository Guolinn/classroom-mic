# Local development: http://localhost:3000
PORT=3000
HOST=0.0.0.0
# Set this to the real HTTPS origin before deploying (no trailing path).
# PUBLIC_URL=https://mic.example.com
# Optional: protect classroom creation with a teacher password.
# HOST_PASSWORD=replace-with-a-long-random-password
# Set only when the app is reachable exclusively through your trusted reverse proxy.
TRUST_PROXY=0
MAX_ROOMS=100
MAX_STUDENTS=300
# Optional private TURN servers; never put long-lived privileged API keys here.
# ICE_SERVERS_JSON=[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"classroom","credential":"replace-me"}]
# Used by Docker Compose + Caddy:
# DOMAIN=mic.example.com
